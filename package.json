{
  "name": "qictrader-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "private": true,
  "description": "QicTrader React Native mobile app (iOS + Android). Feature parity with web frontend.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20",
    "bun": ">=1.1"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts,.tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "sync": "./scripts/sync-from-web.sh",
    "sync:check": "./scripts/sync-from-web.sh --check"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@hookform/resolvers": "^5.4.0",
    "@react-native-async-storage/async-storage": "^3.1.0",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@reduxjs/toolkit": "^2.8.2",
    "@shopify/flash-list": "^2.3.1",
    "@tanstack/query-async-storage-persister": "^5.100.13",
    "@tanstack/react-query": "^5.80.2",
    "@tanstack/react-query-persist-client": "^5.100.13",
    "axios": "^1.9.0",
    "expo": "~56.0.3",
    "expo-apple-authentication": "^56.0.4",
    "expo-constants": "~56.0.14",
    "expo-device": "^56.0.4",
    "expo-font": "~56.0.5",
    "expo-image-picker": "^56.0.12",
    "expo-linking": "~56.0.11",
    "expo-local-authentication": "~56.0.4",
    "expo-notifications": "~0.31.1",
    "expo-router": "~56.2.5",
    "expo-secure-store": "~56.0.4",
    "expo-splash-screen": "~56.0.9",
    "expo-status-bar": "~56.0.4",
    "expo-symbols": "~56.0.5",
    "expo-web-browser": "~56.0.5",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.56.4",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "^2.31.2",
    "react-native-reanimated": "^4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "^13.16.1",
    "react-native-worklets": "0.8.3",
    "react-redux": "^9.2.0",
    "socket.io-client": "^4.8.1",
    "zod": "^3.24.4",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "@types/react-test-renderer": "~19.1.0",
    "@typescript-eslint/eslint-plugin": "^8.33.0",
    "@typescript-eslint/parser": "^8.33.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.28.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.1.0",
    "jest": "^29.7.0",
    "jest-expo": "~56.0.4",
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.12",
    "react-test-renderer": "~19.2.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFilesAfterFramework": ["./jest.setup.ts"],
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@unimodules/.*|unimodules|sentry-expo|native-base|react-native-svg|@shopify/flash-list)"
    ]
  }
}
