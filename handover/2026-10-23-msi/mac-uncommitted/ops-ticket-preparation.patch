+def size_for(p):
+    """Size from plan facts alone. A missing estimate can only be L, never S or M."""
+    facts = size_facts(p)
+    eligible = eligible_sizes(p)
+    for size, limit in SIZE_LIMITS.items():
+        if not eligible[size]:
