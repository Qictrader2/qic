{
  "expo": {
    "name": "QicTrader",
    "slug": "qictrader",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qictrader",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qictrader.app",
      "buildNumber": "1",
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "associatedDomains": [
        "applinks:qictrader.com",
        "applinks:app.qictrader.com",
        "applinks:qictrader.com",
        "applinks:app.qictrader.com"
      ],
      "entitlements": {
        "com.apple.developer.associated-domains": [
          "applinks:qictrader.com",
          "applinks:app.qictrader.com",
          "applinks:qictrader.com",
          "applinks:app.qictrader.com"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "QicTrader uses your camera to capture proof of payment and KYC identity documents.",
        "NSPhotoLibraryUsageDescription": "QicTrader needs access to your photo library to upload proof of payment and identity documents.",
        "NSFaceIDUsageDescription": "QicTrader uses Face ID to protect your account and authorize sensitive actions like withdrawals.",
        "NSLocalNetworkUsageDescription": "Used for development builds only.",
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "qictrader",
          "qictrader"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#00A3F6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "com.qictrader.app",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "allowBackup": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qictrader.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "app.qictrader.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "qictrader.com",
              "pathPrefix": "/app"
            },
            {
              "scheme": "https",
              "host": "app.qictrader.com"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-local-authentication",
      "expo-apple-authentication",
      "expo-image-picker",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "note": "Set SENTRY_AUTH_TOKEN in EAS Secrets for source map upload"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#00A3F6",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4",
            "useFrameworks": "static"
          },
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3d4a7727-a8ac-4e1f-acf2-d2e655d5c46b"
      }
    },
    "owner": "jpvanzyl",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3d4a7727-a8ac-4e1f-acf2-d2e655d5c46b"
    }
  }
}
